---
import ExternalIcon from './ExternalIcon.astro';
import { getVrEvents } from '../lib/microcms-events';
const vrEvents = await getVrEvents();
---
<section class="vr-events" id="vr-events" aria-labelledby="vr-events-heading">
  <h3 id="vr-events-heading">VR EVENTS</h3>
  <p class="vr-events__description">イベントキャスト・個人イベントなど</p>
  <div class="vr-events__grid">
    {vrEvents.map(event => (
      <a class="vr-event" href={event.href} target="_blank" rel="noreferrer" aria-label={event.name + (event.description ? '：' + event.description : '') + '（外部サイト）'}>
        <img src={event.logo} alt="" width={event.width} height={event.height} loading="lazy" decoding="async" />
        <span class="vr-event__overlay" aria-hidden="true"></span>
        <h4>{event.name}</h4>
        {event.description && <p>{event.description}</p>}
        <span class="vr-event__external" aria-hidden="true"><ExternalIcon /></span>
      </a>
    ))}
  </div>
  {vrEvents.length === 0 && <p class="vr-events__empty">現在、掲載中のイベントはありません。</p>}
</section>
<style>
  .vr-events__empty { text-align:center; color:var(--color-text-muted); font-size:.875rem; }
  .vr-events { margin-top:40px; scroll-margin-top:calc(var(--header-height) + 24px); }
  h3 { margin-bottom:8px; text-align:center; color:var(--color-text-muted); font:600 .875rem/1.5 var(--font-display); letter-spacing:.14em; }
  .vr-events__description { margin:0 0 20px; text-align:center; color:var(--color-text-muted); font-size:.75rem; line-height:1.7; }
  .vr-events__grid { width:80%; margin-inline:auto; display:flex; flex-wrap:wrap; justify-content:center; gap:16px; }
  .vr-event { position:relative; isolation:isolate; display:block; flex:0 0 calc((100% - 32px) / 3); min-width:0; background:#000; color:#fff; outline:1px solid var(--color-line); outline-offset:0; }
  .vr-event img { position:relative; z-index:0; display:block; width:100%; height:auto; }
  .vr-event__overlay { position:absolute; z-index:1; inset:0; display:block; background:linear-gradient(180deg,rgb(0 0 0 / 48%),rgb(0 0 0 / 35%) 45%,rgb(0 0 0 / 50%)); pointer-events:none; }
  h4, .vr-event p { position:absolute; z-index:2; margin:0; color:rgb(255 255 255 / 88%); text-shadow:0 1px 3px #000,0 0 6px #000; }
  h4 { top:8px; left:10px; right:30px; font:500 .6875rem/1.5 var(--font-display); }
  .vr-event p { right:10px; bottom:8px; left:10px; text-align:right; font-size:.625rem; line-height:1.5; overflow-wrap:anywhere; }
  .vr-event__external { position:absolute; z-index:2; top:8px; right:10px; color:rgb(255 255 255 / 65%); font-size:.6875rem; }
  .vr-event:hover { outline-color:var(--color-line-accent); }
  .vr-event:focus-visible { outline:2px solid var(--color-accent); outline-offset:4px; }
  @media(max-width:900px) { .vr-events__grid { width:90%; } .vr-event { flex-basis:calc((100% - 16px) / 2); } }
  @media(max-width:560px) { .vr-events__grid { width:100%; max-width:320px; } .vr-event { flex-basis:100%; } }
</style>
