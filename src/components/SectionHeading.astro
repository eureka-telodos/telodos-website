---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'center' } = Astro.props;
const subtitles: Record<string, string> = {
  'Latest Update': 'お知らせ・最近の活動',
  'Into the Night': '配信・動画',
  'Character Profile': 'プロフィール',
  'Join the Coven': 'ファンクラブ・ショップ',
  'Guidelines': '活動ガイドライン',
  'Design Archive': '公式デザイン資料',
  'First Visit': '初めての方へ',
  'Contact': 'お問い合わせ',
};
const headings: Record<string, { category: string; title: string }> = {
  'Into the Night': { category: '配信・動画', title: 'STREAMS & VIDEOS' },
  'Join the Coven': { category: 'ファンクラブ・ショップ', title: 'SUPPORT & SHOP' },
};
const category = headings[title]?.category ?? subtitles[title] ?? eyebrow;
const displayTitle = headings[title]?.title ?? title;
---

<header class:list={['section-heading', `section-heading--${align}`]}>
  <p class="section-heading__eyebrow"><span aria-hidden="true">✦</span>{category}</p>
  <h2>{displayTitle}</h2>
  {description && <p class="section-heading__description">{description}</p>}
</header>

<style>
  .section-heading__subtitle { margin-top: 16px; color: var(--color-accent); font-size: 1rem; }
</style>
