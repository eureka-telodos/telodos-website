---
import { socialLinks } from '../data/site';
---

<section class="hero" id="top" aria-labelledby="hero-title" data-hero>
  <h1 class="sr-only" id="hero-title">ユリーカ・ティロドス 公式サイト</h1>

  <div class="hero__layer hero__background" data-parallax="0.012" aria-hidden="true">
    <img src="/images/hero/background.webp" alt="" width="3840" height="2160" fetchpriority="high" />
  </div>

  <div class="hero__layer hero__character-back" data-parallax="0.032" aria-hidden="true">
    <img src="/images/hero/character-main.webp" alt="" width="3840" height="3840" fetchpriority="high" />
  </div>

  <div class="hero__layer hero__character-main" data-parallax="0.022">
    <img
      src="/images/hero/character-main.webp"
      alt="ユリーカ・ティロドス メインビジュアル"
      width="3840"
      height="3840"
      fetchpriority="high"
    />
  </div>

  <div class="hero__layer hero__effects" data-parallax="0.042" aria-hidden="true">
    <img src="/images/hero/effects.webp" alt="" width="3840" height="2160" fetchpriority="high" />
  </div>

  <div class="hero__frame" aria-hidden="true">
    <span></span><span></span><span></span><span></span>
  </div>

  <div class="hero__logo" data-parallax="0.05">
    <img src="/images/brand/logo-outline.webp" alt="Eureka Telodos" width="1920" height="1080" />
  </div>

  <div class="hero__identity">
    <p>VAMPIRE VTUBER <span>/</span> VRCHAT CREATOR</p>
    <div class="hero__socials">
      {socialLinks.map((item) => <a href={item.href} target="_blank" rel="noreferrer">{item.label}</a>)}
    </div>
  </div>

  <a class="hero__scroll" href="#news">
    <span>SCROLL TO ENTER</span>
    <i aria-hidden="true"></i>
  </a>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && !reduceMotion && window.matchMedia('(pointer: fine)').matches) {
    const layers = [...hero.querySelectorAll<HTMLElement>('[data-parallax]')];
    let pointerX = 0;
    let pointerY = 0;
    let currentX = 0;
    let currentY = 0;
    let frame = 0;

    const render = () => {
      currentX += (pointerX - currentX) * 0.075;
      currentY += (pointerY - currentY) * 0.075;

      layers.forEach((layer) => {
        const speed = Number(layer.dataset.parallax ?? 0);
        layer.style.setProperty('--parallax-x', `${currentX * speed}px`);
        layer.style.setProperty('--parallax-y', `${currentY * speed}px`);
      });

      const settled = Math.abs(pointerX - currentX) < 0.1 && Math.abs(pointerY - currentY) < 0.1;
      frame = settled ? 0 : window.requestAnimationFrame(render);
    };

    hero.addEventListener(
      'pointermove',
      (event) => {
        const bounds = hero.getBoundingClientRect();
        pointerX = event.clientX - bounds.left - bounds.width / 2;
        pointerY = event.clientY - bounds.top - bounds.height / 2;
        if (!frame) frame = window.requestAnimationFrame(render);
      },
      { passive: true },
    );

    hero.addEventListener('pointerleave', () => {
      pointerX = 0;
      pointerY = 0;
      if (!frame) frame = window.requestAnimationFrame(render);
    });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    isolation: isolate;
    overflow: hidden;
    background: #050306;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    z-index: 7;
    height: 18%;
    background: linear-gradient(to bottom, transparent, var(--color-bg));
    pointer-events: none;
  }

  .hero__layer {
    position: absolute;
    pointer-events: none;
    transform: translate3d(var(--parallax-x, 0), var(--parallax-y, 0), 0);
    will-change: transform;
  }

  .hero__background {
    inset: -6%;
    z-index: 1;
  }

  .hero__background::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 74% 26%, transparent 0 22%, rgb(4 2 7 / 24%) 58%),
      linear-gradient(90deg, rgb(5 3 7 / 44%), transparent 38% 72%, rgb(5 3 7 / 12%));
  }

  .hero__background img,
  .hero__effects img,
  .hero__character-main img,
  .hero__character-back img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__character-main,
  .hero__character-back,
  .hero__effects {
    inset: -3%;
  }

  .hero__character-back {
    z-index: 2;
    opacity: 0.42;
    filter: brightness(0) saturate(100%) invert(76%) sepia(98%) saturate(2035%) hue-rotate(57deg)
      brightness(103%) contrast(105%) blur(18px);
  }

  .hero__character-main {
    z-index: 3;
  }

  .hero__character-main img {
    object-position: top center;
    mix-blend-mode: lighten;
  }

  .hero__character-back img {
    object-position: top center;
  }

  .hero__effects {
    z-index: 4;
    opacity: 0.68;
    mix-blend-mode: screen;
  }

  .hero__frame {
    position: absolute;
    inset: max(16px, 2vw);
    z-index: 8;
    border: 1px solid rgb(57 255 20 / 15%);
    pointer-events: none;
  }

  .hero__frame span {
    position: absolute;
    width: 22px;
    height: 22px;
    border-color: var(--color-accent);
  }

  .hero__frame span:nth-child(1) { inset: -1px auto auto -1px; border-style: solid; border-width: 2px 0 0 2px; }
  .hero__frame span:nth-child(2) { inset: -1px -1px auto auto; border-style: solid; border-width: 2px 2px 0 0; }
  .hero__frame span:nth-child(3) { inset: auto auto -1px -1px; border-style: solid; border-width: 0 0 2px 2px; }
  .hero__frame span:nth-child(4) { inset: auto -1px -1px auto; border-style: solid; border-width: 0 2px 2px 0; }

  .hero__logo {
    position: absolute;
    z-index: 6;
    inset: 50% auto auto 50%;
    width: min(36vw, 520px);
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    transform: translate3d(calc(-50% + var(--parallax-x, 0px)), calc(-50% + var(--parallax-y, 0px)), 0);
    pointer-events: none;
  }

  .hero__logo img {
    width: 100%;
    filter: drop-shadow(0 0 20px rgb(57 255 20 / 32%));
  }

  .hero__identity {
    position: absolute;
    z-index: 9;
    left: max(28px, calc((100vw - var(--container-wide)) / 2));
    bottom: clamp(38px, 6vh, 74px);
    display: grid;
    gap: 15px;
  }

  .hero__identity p {
    color: rgb(255 255 255 / 58%);
    font: 600 0.64rem/1.4 var(--font-display);
    letter-spacing: 0.2em;
  }

  .hero__identity p span {
    color: var(--color-accent);
    margin-inline: 8px;
  }

  .hero__socials {
    display: flex;
    gap: 20px;
  }

  .hero__socials a {
    color: var(--color-text);
    font: 600 0.7rem/1 var(--font-display);
    letter-spacing: 0.12em;
  }

  .hero__scroll {
    position: absolute;
    z-index: 9;
    right: max(28px, calc((100vw - var(--container-wide)) / 2));
    bottom: clamp(38px, 6vh, 74px);
    display: flex;
    align-items: center;
    gap: 15px;
    color: rgb(255 255 255 / 58%);
    font: 600 0.58rem/1 var(--font-display);
    letter-spacing: 0.18em;
  }

  .hero__scroll i {
    display: block;
    width: 48px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent), transparent);
    transform-origin: left;
    animation: scan 2.4s ease-in-out infinite;
  }

  @keyframes scan {
    0%, 100% { transform: scaleX(0.35); opacity: 0.4; }
    50% { transform: scaleX(1); opacity: 1; }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 100svh;
    }

    .hero__background {
      inset: -2% -32%;
    }

    .hero__background img {
      object-position: 58% center;
    }

    .hero__character-main,
    .hero__character-back,
    .hero__effects {
      inset: 0 auto 0 -18%;
      width: 128%;
    }

    .hero__character-main img,
    .hero__character-back img {
      object-fit: contain;
      object-position: center;
    }

    .hero__effects img {
      object-fit: contain;
      object-position: bottom center;
    }

    .hero__logo {
      top: 60%;
      width: min(78vw, 400px);
    }

    .hero__identity {
      left: 24px;
      bottom: 34px;
    }

    .hero__identity p,
    .hero__scroll span {
      display: none;
    }

    .hero__scroll {
      right: 24px;
      bottom: 40px;
    }

    .hero__scroll i {
      width: 38px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__layer,
    .hero__logo {
      transform: none;
      will-change: auto;
    }

    .hero__logo {
      transform: translate(-50%, -50%);
    }

    .hero__scroll i {
      animation: none;
    }
  }
</style>
