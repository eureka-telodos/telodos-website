---
import SectionHeading from './SectionHeading.astro';
import { guidelines } from '../data/guidelines';
---

<section class="section guidelines-section" id="guidelines">
  <div class="container guidelines-layout">
    <div class="guidelines-intro">
      <SectionHeading
        eyebrow="LAW OF COVEN"
        title="Guidelines"
        description="二次創作、コンテンツ利用、その他の活動におけるガイドラインです。"
      />
      <p class="guidelines-intro__note">Last updated — 2026.09.03</p>
    </div>

    <div class="guidelines-list">
      {guidelines.map((item, index) => (
        <details class="guideline" open={index === 0}>
          <summary>
            <span class="guideline__index">{String(index + 1).padStart(2, '0')}</span>
            <span class="guideline__title"><small>{item.label}</small>{item.title}</span>
            <i aria-hidden="true"></i>
          </summary>
          <div class="guideline__content"><p>{item.content}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .guidelines-layout {
    display: grid;
    grid-template-columns: minmax(260px, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(48px, 9vw, 130px);
    align-items: start;
  }

  .guidelines-intro {
    position: sticky;
    top: calc(var(--header-height) + 34px);
  }

  .guidelines-intro__note {
    margin-top: 32px;
    color: var(--color-text-faint);
    font: 500 0.58rem/1 var(--font-display);
    letter-spacing: 0.12em;
  }

  .guidelines-list {
    border-top: 1px solid var(--color-line);
  }

  .guideline {
    border-bottom: 1px solid var(--color-line);
  }

  .guideline summary {
    padding: 28px 0;
    display: grid;
    grid-template-columns: 38px 1fr 28px;
    align-items: center;
    gap: 18px;
    cursor: pointer;
    list-style: none;
  }

  .guideline summary::-webkit-details-marker { display: none; }

  .guideline__index {
    color: var(--color-accent);
    font: 600 0.58rem/1 var(--font-display);
  }

  .guideline__title {
    display: grid;
    gap: 8px;
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .guideline__title small {
    color: var(--color-text-faint);
    font: 600 0.52rem/1 var(--font-display);
    letter-spacing: 0.14em;
  }

  .guideline summary i {
    position: relative;
    width: 18px;
    height: 18px;
  }

  .guideline summary i::before,
  .guideline summary i::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 14px;
    height: 1px;
    background: var(--color-text-muted);
    transform: translate(-50%, -50%);
  }

  .guideline summary i::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform 180ms ease;
  }

  .guideline[open] summary i::after { transform: translate(-50%, -50%) rotate(0); }

  .guideline__content {
    padding: 0 46px 30px 56px;
  }

  .guideline__content p {
    color: var(--color-text-muted);
    font-size: 0.78rem;
    line-height: 2.05;
  }

  @media (max-width: 820px) {
    .guidelines-layout { grid-template-columns: 1fr; }
    .guidelines-intro { position: static; }
  }

  @media (max-width: 520px) {
    .guideline summary { grid-template-columns: 28px 1fr 22px; gap: 12px; }
    .guideline__content { padding-inline: 40px 0; }
  }
</style>
