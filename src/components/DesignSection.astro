---
import SectionHeading from './SectionHeading.astro';
import { designAssets } from '../data/design';
---

<section class="section section--deep design-section" id="design">
  <div class="container">
    <div class="design-header">
      <SectionHeading
        eyebrow="OFFICIAL REFERENCES"
        title="Design Archive"
        description="イラスト制作や紹介に使用できる、公式デザインの確認用資料です。"
      />
      <p>Click a sheet to view full size</p>
    </div>

    <div class="design-grid">
      {designAssets.map((asset, index) => (
        <a class="design-card" href={asset.image} target="_blank" rel="noreferrer">
          <div class="design-card__media">
            <img src={asset.image} alt={asset.alt} loading="lazy" decoding="async" />
          </div>
          <div class="design-card__caption">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><h3>{asset.title}</h3><p>{asset.description}</p></div>
            <i aria-hidden="true">↗</i>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .design-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
  }

  .design-header > p {
    padding-bottom: 6px;
    color: var(--color-text-faint);
    font: 500 0.56rem/1 var(--font-display);
    letter-spacing: 0.12em;
  }

  .design-grid {
    margin-top: clamp(42px, 6vw, 72px);
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 16px;
  }

  .design-card {
    grid-column: span 6;
    color: var(--color-text);
  }

  .design-card:nth-child(3) { grid-column: 4 / span 6; }

  .design-card__media {
    aspect-ratio: 16 / 9;
    padding: clamp(12px, 2vw, 24px);
    display: grid;
    place-items: center;
    background:
      linear-gradient(145deg, rgb(255 255 255 / 98%), rgb(220 224 222 / 96%)),
      #fff;
    overflow: hidden;
  }

  .design-card__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 420ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .design-card:hover .design-card__media img { transform: scale(1.025); }

  .design-card__caption {
    padding: 19px 0 28px;
    display: grid;
    grid-template-columns: 32px 1fr auto;
    align-items: start;
    gap: 12px;
    border-bottom: 1px solid var(--color-line);
  }

  .design-card__caption > span,
  .design-card__caption > i {
    color: var(--color-accent);
    font: 600 0.58rem/1.4 var(--font-display);
    font-style: normal;
  }

  .design-card__caption h3 {
    font: 600 0.82rem/1.4 var(--font-display);
    letter-spacing: 0.04em;
  }

  .design-card__caption p {
    margin-top: 7px;
    color: var(--color-text-faint);
    font-size: 0.68rem;
  }

  @media (max-width: 720px) {
    .design-header { align-items: start; flex-direction: column; }
    .design-grid { grid-template-columns: 1fr; }
    .design-card,
    .design-card:nth-child(3) { grid-column: auto; }
  }
</style>
