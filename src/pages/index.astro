---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PortalBar from '../components/PortalBar.astro';
import NewsSection from '../components/NewsSection.astro';
import ActivitySection from '../components/ActivitySection.astro';
import ProfileSection from '../components/ProfileSection.astro';
import LinksSection from '../components/LinksSection.astro';
import GuidelinesSection from '../components/GuidelinesSection.astro';
import DesignSection from '../components/DesignSection.astro';
import Footer from '../components/Footer.astro';
import { site, socialLinks } from '../data/site';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.englishName,
  url: site.url,
  sameAs: socialLinks.map((link) => link.href),
};
---

<BaseLayout>
  <Header />
  <main id="main-content">
    <Hero />
    <PortalBar />
    <NewsSection />
    <ActivitySection />
    <ProfileSection />
    <LinksSection />
    <GuidelinesSection />
    <DesignSection />
  </main>
  <Footer />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
</BaseLayout>
