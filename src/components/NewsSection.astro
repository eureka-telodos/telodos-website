---
import SectionHeading from './SectionHeading.astro';
import { getNews } from '../lib/microcms';

const news = await getNews();
---

<section class="section news-section" id="news">
  <div class="container">
    <SectionHeading
      eyebrow="LATEST NEWS & LOG"
      title="Latest Update"
      description="活動のお知らせ、記念日、新しい挑戦。夜の記録を新しい順に届けます。"
    />

    <div class="news-grid">
      {news.map((item, index) => {
        const Tag = item.href ? 'a' : 'article';
        return (
          <Tag
            class:list={['news-card', index === 0 && 'news-card--featured']}
            href={item.href}
            target={item.href ? '_blank' : undefined}
            rel={item.href ? 'noreferrer' : undefined}
          >
            <div class="news-card__media">
              <img src={item.image} alt={item.imageAlt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
              <span>{item.category}</span>
            </div>
            <div class="news-card__body">
              <time datetime={item.date.replaceAll('.', '-')}>{item.date}</time>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              {item.href && <span class="news-card__link">VIEW STORY <i aria-hidden="true">↗</i></span>}
            </div>
          </Tag>
        );
      })}
    </div>
  </div>
</section>

<style>
  .news-section {
    position: relative;
  }

  .news-section::before {
    content: 'LATEST';
    position: absolute;
    top: 24px;
    right: -0.05em;
    color: rgb(255 255 255 / 1.8%);
    font: 700 clamp(5rem, 15vw, 13rem)/1 var(--font-display);
    letter-spacing: -0.06em;
    pointer-events: none;
  }

  .news-grid {
    margin-top: clamp(40px, 6vw, 72px);
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) repeat(2, minmax(0, 1fr));
    gap: 18px;
    align-items: stretch;
  }

  .news-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    color: var(--color-text);
    border: 1px solid var(--color-line);
    background: linear-gradient(145deg, rgb(20 14 25 / 92%), rgb(11 8 14 / 96%));
    overflow: hidden;
    transition: transform 220ms ease, border-color 220ms ease, background-color 220ms ease;
  }

  .news-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-line-accent);
  }

  .news-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    flex: none;
    overflow: hidden;
    background: var(--color-panel-raised);
  }

  .news-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(8 6 11 / 28%), transparent 55%);
    pointer-events: none;
  }

  .news-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .news-card:hover .news-card__media img { transform: scale(1.025); }

  .news-card__media > span {
    position: absolute;
    z-index: 2;
    top: 14px;
    left: 14px;
    padding: 7px 9px;
    color: var(--color-bg);
    background: var(--color-accent);
    font: 700 0.52rem/1 var(--font-display);
    letter-spacing: 0.12em;
  }

  .news-card__body {
    flex: 1;
    padding: clamp(20px, 2.8vw, 34px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .news-card:not(.news-card--featured) .news-card__body { padding: 22px; }

  .news-card time {
    color: var(--color-accent);
    font: 600 0.58rem/1 var(--font-display);
    letter-spacing: 0.12em;
  }

  .news-card h3 {
    margin-top: 13px;
    font-size: clamp(0.94rem, 1.5vw, 1.22rem);
    line-height: 1.55;
  }

  .news-card--featured h3 {
    font-size: clamp(1.25rem, 2.3vw, 1.9rem);
  }

  .news-card p {
    margin-top: 12px;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    line-height: 1.9;
  }

  .news-card:not(.news-card--featured) p {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .news-card__link {
    margin-top: auto;
    padding-top: 24px;
    color: var(--color-text-faint);
    font: 600 0.58rem/1 var(--font-display);
    letter-spacing: 0.14em;
  }

  .news-card__link i { color: var(--color-accent); font-style: normal; }

  @media (max-width: 900px) {
    .news-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .news-card--featured { grid-column: 1 / -1; }
  }

  @media (max-width: 580px) {
    .news-grid { grid-template-columns: 1fr; }
    .news-card--featured { grid-column: auto; }
    .news-card:not(.news-card--featured) p { -webkit-line-clamp: 3; }
  }
</style>
