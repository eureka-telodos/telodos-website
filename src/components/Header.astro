---
import { navigation, socialLinks } from '../data/site';
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="site-header__brand" href="#top" aria-label="ページ先頭へ">
      <img src="/images/brand/logo-outline.webp" alt="ユリーカ・ティロドス" width="1920" height="1080" />
    </a>

    <nav class="site-header__nav" aria-label="メインナビゲーション">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="site-header__actions">
      <a class="site-header__live" href="https://twitch.tv/eureka_td" target="_blank" rel="noreferrer">
        <span aria-hidden="true"></span>ON AIR
      </a>
      <button class="site-header__menu" type="button" aria-expanded="false" aria-controls="mobile-navigation">
        <span></span><span></span>
        <span class="sr-only">メニューを開く</span>
      </button>
    </div>
  </div>

  <div class="mobile-navigation" id="mobile-navigation" hidden>
    <nav aria-label="モバイルナビゲーション">
      {navigation.map((item, index) => (
        <a href={item.href}><span>{String(index + 1).padStart(2, '0')}</span>{item.label}</a>
      ))}
    </nav>
    <div class="mobile-navigation__socials">
      {socialLinks.map((item) => <a href={item.href} target="_blank" rel="noreferrer">{item.label}</a>)}
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menuButton = header?.querySelector<HTMLButtonElement>('.site-header__menu');
  const mobileNavigation = header?.querySelector<HTMLElement>('#mobile-navigation');
  const desktopMedia = window.matchMedia('(min-width: 961px)');

  const closeMenu = () => {
    if (!menuButton || !mobileNavigation) return;
    menuButton.setAttribute('aria-expanded', 'false');
    mobileNavigation.hidden = true;
    document.documentElement.classList.remove('menu-open');
  };

  menuButton?.addEventListener('click', () => {
    if (!mobileNavigation) return;
    const willOpen = menuButton.getAttribute('aria-expanded') !== 'true';
    menuButton.setAttribute('aria-expanded', String(willOpen));
    mobileNavigation.hidden = !willOpen;
    document.documentElement.classList.toggle('menu-open', willOpen);
  });

  mobileNavigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  desktopMedia.addEventListener('change', (event) => event.matches && closeMenu());
  window.addEventListener('keydown', (event) => event.key === 'Escape' && closeMenu());
  window.addEventListener(
    'scroll',
    () => header?.classList.toggle('site-header--scrolled', window.scrollY > 24),
    { passive: true },
  );
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: var(--header-height);
    border-bottom: 1px solid transparent;
    transition: background-color 220ms ease, border-color 220ms ease, backdrop-filter 220ms ease;
  }

  .site-header--scrolled,
  :global(.menu-open) .site-header {
    background: rgb(8 6 11 / 88%);
    border-color: var(--color-line);
    backdrop-filter: blur(18px);
  }

  .site-header__inner {
    width: min(100% - 40px, var(--container-wide));
    height: 100%;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 180px 1fr 180px;
    align-items: center;
    gap: 24px;
  }

  .site-header__brand {
    width: 154px;
    height: 62px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .site-header__brand img {
    width: 176px;
    height: auto;
    max-width: none;
    filter: drop-shadow(0 0 10px rgb(57 255 20 / 24%));
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(18px, 2.2vw, 34px);
  }

  .site-header__nav a,
  .site-header__live {
    color: var(--color-text-muted);
    font: 600 0.66rem/1 var(--font-display);
    letter-spacing: 0.16em;
    transition: color 180ms ease;
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus-visible {
    color: var(--color-accent);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .site-header__live {
    min-height: 38px;
    padding: 0 16px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--color-accent);
    border: 1px solid var(--color-accent-dim);
    background: rgb(8 6 11 / 34%);
  }

  .site-header__live span {
    width: 6px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 10px currentColor;
  }

  .site-header__menu,
  .mobile-navigation {
    display: none;
  }

  @media (max-width: 960px) {
    .site-header__inner {
      width: min(100% - 28px, var(--container-wide));
      grid-template-columns: 1fr auto 1fr;
    }

    .site-header__brand {
      grid-column: 2;
      width: 136px;
    }

    .site-header__nav,
    .site-header__live {
      display: none;
    }

    .site-header__actions {
      grid-column: 3;
    }

    .site-header__menu {
      display: grid;
      place-content: center;
      gap: 7px;
      width: 42px;
      aspect-ratio: 1;
      color: var(--color-text);
      border: 1px solid var(--color-line-strong);
      background: rgb(8 6 11 / 56%);
    }

    .site-header__menu > span:not(.sr-only) {
      display: block;
      width: 18px;
      height: 1px;
      background: currentColor;
      transition: transform 180ms ease;
    }

    .site-header__menu[aria-expanded='true'] > span:first-child {
      transform: translateY(4px) rotate(45deg);
    }

    .site-header__menu[aria-expanded='true'] > span:nth-child(2) {
      transform: translateY(-4px) rotate(-45deg);
    }

    .mobile-navigation {
      position: fixed;
      inset: var(--header-height) 0 0;
      min-height: 0;
      padding: 34px max(24px, calc((100vw - var(--container)) / 2));
      display: grid;
      align-content: space-between;
      overflow-y: auto;
      overscroll-behavior: contain;
      background: rgb(8 6 11 / 97%);
    }

    .mobile-navigation[hidden] {
      display: none;
    }

    .mobile-navigation nav {
      display: grid;
    }

    .mobile-navigation nav a {
      padding: 18px 0;
      display: flex;
      gap: 18px;
      color: var(--color-text);
      font: 600 clamp(1.15rem, 5vw, 1.7rem)/1 var(--font-display);
      letter-spacing: 0.1em;
      border-bottom: 1px solid var(--color-line);
    }

    .mobile-navigation nav a span {
      color: var(--color-accent);
      font-size: 0.62rem;
    }

    .mobile-navigation__socials {
      padding-block: 28px 10px;
      display: flex;
      gap: 24px;
    }

    .mobile-navigation__socials a {
      color: var(--color-text-muted);
      font: 600 0.72rem/1 var(--font-display);
      letter-spacing: 0.12em;
    }
  }
</style>
