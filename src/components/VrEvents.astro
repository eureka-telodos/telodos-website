---
import ExternalIcon from './ExternalIcon.astro';
import { vrEvents } from '../data/vr-events';
---
<section class="vr-events" aria-labelledby="vr-events-heading">
  <h3 id="vr-events-heading">VR EVENTS</h3>
  <div class="vr-events__grid">
    {vrEvents.map(event => (
      <a class="vr-event" href={event.href} target="_blank" rel="noreferrer" aria-label={event.name + '：' + event.description + '（Xで見る）'}>
        <img src={event.logo} alt="" width={event.width} height={event.height} loading="lazy" decoding="async" />
        <h4>{event.name}</h4>
        <p>{event.description}</p>
        <span class="vr-event__external" aria-hidden="true"><ExternalIcon /></span>
      </a>
    ))}
  </div>
</section>
<style>
  .vr-events { margin-top:40px; }
  h3 { margin-bottom:20px; text-align:center; color:var(--color-text-muted); font:600 .875rem/1.5 var(--font-display); letter-spacing:.14em; }
  .vr-events__grid { display:flex; flex-wrap:wrap; justify-content:center; gap:16px; }
  .vr-event { position:relative; display:block; flex:0 0 calc((100% - 32px) / 3); min-width:0; background:#000; color:#fff; outline:1px solid var(--color-line); outline-offset:0; }
  .vr-event img { display:block; width:100%; height:auto; }
  h4, p { position:absolute; z-index:1; margin:0; color:rgb(255 255 255 / 78%); text-shadow:0 1px 3px #000,0 0 6px #000; }
  h4 { top:8px; left:10px; right:30px; font:500 .6875rem/1.5 var(--font-display); }
  p { right:10px; bottom:8px; left:10px; text-align:right; font-size:.625rem; line-height:1.5; overflow-wrap:anywhere; }
  .vr-event__external { position:absolute; top:8px; right:10px; color:rgb(255 255 255 / 65%); font-size:.6875rem; }
  .vr-event:hover { outline-color:var(--color-line-accent); }
  .vr-event:focus-visible { outline:2px solid var(--color-accent); outline-offset:4px; }
  @media(max-width:900px) { .vr-event { flex-basis:calc((100% - 16px) / 2); } }
  @media(max-width:560px) { .vr-event { flex-basis:100%; } }
</style>
