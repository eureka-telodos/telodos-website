---
import { designAssets } from '../data/design';
---
<div class="container design-references" id="design">
  <header><h3>Design References</h3><p>公式デザイン・制作資料</p></header>
  <div class="reference-list">
    {designAssets.map((asset,index) => (
      <a class="reference-item" href={asset.image} target="_blank" rel="noreferrer">
        <div class:list={['reference-image', index === 2 && 'reference-image--logo']}>
          <img src={asset.image} alt={asset.alt} width="1920" height="1080" loading="lazy" decoding="async" />
        </div>
        <span><strong>{asset.title}</strong><small>{asset.description}</small></span><i aria-hidden="true">↗</i>
      </a>
    ))}
  </div>
</div>
<style>
  .design-references { margin-top: 64px; padding-top: 40px; border-top: 1px solid var(--color-line); }
  header { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12px 24px; }
  h3 { font: 600 clamp(1.6rem,3vw,2.3rem)/1.3 var(--font-display); }
  header p { font-size: .875rem; color: var(--color-text-muted); }
  .reference-list { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 24px; margin-top: 28px; }
  .reference-item { display: grid; grid-template-columns: minmax(0,1fr) auto; align-content: start; gap: 16px; }
  .reference-image { grid-column: 1 / -1; aspect-ratio:16/9; padding: 12px; background: #eee; overflow: hidden; border: 1px solid var(--color-line-strong); transition: border-color 220ms; }
  .reference-image--logo { background: #17101d; }
  img { width:100%; height:100%; object-fit:contain; }
  strong { display:block; font:600 1rem/1.5 var(--font-display); }
  small { display:block; margin-top:6px; color:var(--color-text-muted); font-size:.875rem; }
  i { color:var(--color-accent); font-style:normal; }
  a:hover .reference-image { border-color:var(--color-accent); }
  @media(max-width:700px) { .reference-list { grid-template-columns: 1fr; } .reference-item { grid-template-columns: 100px minmax(0,1fr) auto; align-items:center; } .reference-image { grid-column:1; } }
</style>
