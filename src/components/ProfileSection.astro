---
import SectionHeading from './SectionHeading.astro';
import { profile } from '../data/site';
---

<section class="section profile-section" id="profile">
  <div class="container profile-layout">
    <div class="profile-visual">
      <span class="profile-visual__word" aria-hidden="true">VAMPIRE</span>
      <img src="/images/profile/standing.webp" alt="ユリーカ・ティロドス立ち絵" width="2560" height="3840" loading="lazy" decoding="async" />
      <div class="profile-visual__quote">
        <p>{profile.englishCatchphrase}</p>
        <strong>「{profile.catchphrase}」</strong>
      </div>
    </div>

    <div class="profile-content">
      <SectionHeading eyebrow="BIOGRAPHY" title="Character Profile" />
      <p class="profile-content__intro">{profile.introduction}</p>

      <dl class="profile-facts">
        {profile.facts.map((fact) => (
          <div>
            <dt>{fact.label}<span>{fact.englishLabel}</span></dt>
            <dd class:list={'accent' in fact && fact.accent ? 'is-accent' : undefined}>{fact.value}</dd>
          </div>
        ))}
      </dl>

      <div class="profile-tags">
        {profile.tags.map((tag) => (
          <p><span>{tag.label}</span><strong>{tag.value}</strong></p>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .profile-section {
    overflow: hidden;
  }

  .profile-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
    gap: clamp(48px, 8vw, 120px);
    align-items: center;
  }

  .profile-visual {
    position: relative;
    min-height: 680px;
    display: grid;
    place-items: end center;
    isolation: isolate;
    border: 1px solid var(--color-line);
    background:
      radial-gradient(circle at 65% 35%, rgb(57 255 20 / 13%), transparent 38%),
      linear-gradient(145deg, var(--color-panel-raised), var(--color-bg));
    overflow: hidden;
  }

  .profile-visual::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    height: 46%;
    background: linear-gradient(to bottom, transparent, rgb(8 6 11 / 95%));
    pointer-events: none;
  }

  .profile-visual img {
    position: absolute;
    z-index: 1;
    inset: auto 50% 0 auto;
    width: min(88%, 570px);
    height: 94%;
    object-fit: contain;
    object-position: bottom;
    transform: translateX(50%);
    filter: drop-shadow(0 0 28px rgb(57 255 20 / 12%));
  }

  .profile-visual__word {
    position: absolute;
    z-index: 0;
    inset: 28px auto auto -0.08em;
    color: rgb(255 255 255 / 2.4%);
    font: 700 clamp(4rem, 9vw, 8rem)/1 var(--font-display);
    writing-mode: vertical-rl;
    letter-spacing: -0.06em;
  }

  .profile-visual__quote {
    position: relative;
    z-index: 3;
    padding: 42px 24px;
    text-align: center;
  }

  .profile-visual__quote p {
    color: var(--color-accent);
    font: 500 0.72rem/1.4 var(--font-display);
    letter-spacing: 0.1em;
  }

  .profile-visual__quote strong {
    margin-top: 10px;
    display: block;
    color: var(--color-text-strong);
    font-size: clamp(1rem, 2vw, 1.35rem);
    letter-spacing: 0.06em;
  }

  .profile-content__intro {
    margin-top: 34px;
    color: var(--color-text-muted);
    font-size: 0.86rem;
    line-height: 2.05;
  }

  .profile-facts {
    margin-top: 32px;
    border-top: 1px solid var(--color-line);
  }

  .profile-facts > div {
    padding: 17px 0;
    display: grid;
    grid-template-columns: minmax(150px, 0.85fr) 1.15fr;
    align-items: baseline;
    gap: 20px;
    border-bottom: 1px solid var(--color-line);
  }

  .profile-facts dt {
    color: var(--color-text-muted);
    font-size: 0.72rem;
  }

  .profile-facts dt span {
    margin-left: 8px;
    color: var(--color-text-faint);
    font: 500 0.52rem/1 var(--font-display);
    text-transform: uppercase;
  }

  .profile-facts dd {
    color: var(--color-text);
    font-size: 0.82rem;
    font-weight: 600;
    text-align: right;
  }

  .profile-facts dd.is-accent { color: var(--color-accent); }

  .profile-tags {
    margin-top: 26px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .profile-tags p {
    padding: 11px 14px;
    display: flex;
    gap: 11px;
    border: 1px solid var(--color-line);
    background: var(--color-panel);
    font-size: 0.68rem;
  }

  .profile-tags span { color: var(--color-text-faint); }
  .profile-tags strong { color: var(--color-accent); }

  @media (max-width: 920px) {
    .profile-layout { grid-template-columns: 1fr; }
    .profile-visual { min-height: min(680px, 112vw); }
    .profile-content { grid-row: 1; }
  }

  @media (max-width: 520px) {
    .profile-facts > div { grid-template-columns: 1fr; gap: 8px; }
    .profile-facts dd { text-align: left; }
  }
</style>
